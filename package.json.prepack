    "eslint-import-resolver-typescript": "^4.4.4",
    "eslint-plugin-import": "^2.32.0",
    "eslint-plugin-oxlint": "^1.26.0",
    "express": "^5.1.0",
    "fzstd": "^0.1.1",
    "glob": "^11.0.3",
    "http-server": "^14.1.1",
    "jsdom": "^27.1.0",
    "msw": "<2.8.0",
    "oxlint": "^1.26.0",
    "playwright": "^1.56.1",
    "prettier": "3.6.2",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.46.3",
    "vite": "^7.3.1",
    "vite-plugin-dts": "^4.5.4",
    "vitest": "<4",

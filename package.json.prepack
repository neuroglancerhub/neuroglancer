{
  "name": "@janelia-flyem/neuroglancer",
  "description": "Visualization tool for 3-D volumetric data (Janelia fork).",
  "license": "Apache-2.0",
  "version": "2.41.2",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/neuroglancerhub/neuroglancer.git"
  },
  "engines": {
    "node": ">=22.18"
  },
  "browserslist": [
    "last 2 Chrome versions",
    "last 2 Firefox versions",
    "last 2 Safari versions"
  ],
  "dependencies": {
    "codemirror": "^5.61.1",
    "core-js": "^3.46.0",
    "crc-32": "^1.2.2",
    "gl-matrix": "3.1.0",
    "ikonate": "github:mikolajdobrucki/ikonate#a86b4107c6ec717e7877f880a930d1ccf0b59d89",
    "lodash-es": "^4.17.21",
    "msgpackr": "^1.11.5",
    "nifti-reader-js": "^0.8.0",
    "numcodecs": "^0.3.2",
    "valibot": "^1.1.0"
  },
  "overrides": {
    "@puppeteer/browsers": ">=2",
    "ikonate": {
      "jsdom": "npm:dry-uninstall@0.3.0",
      "xmldom": "npm:dry-uninstall@0.3.0",
      "pretty": "npm:dry-uninstall@0.3.0"
    }
  },
  "files": [
    "lib/**/*"
  ],
  "private": false,
  "type": "module",
  "main": "dist/lib-janelia/main.js",
  "exports": {
    ".": {
      "types": "./dist/lib/main.d.js",
      "default": "./dist/lib/main.js"
    },
    "./janelia": {
      "types": "./dist/lib-janelia/main.d.js",
      "default": "./dist/lib-janelia/main.js"
    },
    "./workers/*": "./dist/lib/*.js",
    "./janelia/workers/*": "./dist/lib-janelia/*.js",
    "./style.css": "./dist/lib/neuroglancer.css",
    "./janelia/style.css": "./dist/lib-janelia/neuroglancer.css",
    "./unstable/*.js": "./lib/*.js",
    "./unstable/*": "./lib/*"
  },
  "imports": {
    "#src/third_party/jpgjs/jpg.js": "./lib/third_party/jpgjs/jpg.js",
    "#src/async_computation/decode_zstd.js": {
      "default": "./lib/async_computation/decode_zstd.js"
    },
    "#src/*.js": "./lib/*.js",
    "#src/*": "./lib/*",
    "#datasource/boss/backend": {
      "neuroglancer/datasource/boss:enabled": "./lib/datasource/boss/backend.js",

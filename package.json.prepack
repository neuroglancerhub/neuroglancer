  "scripts": {
    "update-conditions": "node ./build_tools/update-conditions.ts",
    "prepare": "node ./build_tools/build-package.ts --inplace --if-not-toplevel",
    "prepack": "node ./build_tools/build-package.ts --inplace",
    "postpack": "node ./build_tools/postpack.ts",
    "build": "node ./build_tools/cli.ts build",
    "build:watch": "node ./build_tools/cli.ts build --watch",
    "dev-server": "node ./build_tools/cli.ts serve",
    "dev-server-python": "node ./build_tools/cli.ts --python serve",
    "build-package": "node ./build_tools/build-package.ts",
    "build-python": "node ./build_tools/cli.ts --python build",
    "build-python:watch": "node ./build_tools/cli.ts --python build --watch",
    "test": "vitest --run",
    "test:watch": "vitest watch",
    "example-project-test": "playwright test",
    "benchmark": "vitest bench --run",
    "benchmark:watch": "vitest bench",
    "lint:check": "oxlint && eslint . --cache --format codeframe",
    "lint:fix": "oxlint --fix && eslint . --cache --fix --format codeframe && prettier --cache -w -l .",
    "format:check": "prettier --cache . -c",
    "format:fix": "prettier --cache -w -l .",
    "typecheck": "tsgo --noEmit",
    "typecheck:watch": "tsgo --noEmit --watch",
    "version": "node ./build_tools/after-version-change.ts",
    "build:lib": "vite build --config vite.config.lib.ts",
    "build:lib-janelia": "vite build --config vite.config.janelia.ts"
  },
